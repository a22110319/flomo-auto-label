{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "flomo 快速采集器",
  "version": "0.1.0",
  "identifier": "com.local.flomo-capture",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "flomo 快速采集器",
        "width": 880,
        "height": 620,
        "minWidth": 360,
        "minHeight": 520,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": []
  }
}
